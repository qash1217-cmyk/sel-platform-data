rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && request.auth.token.admin == true; }
    function isEditor() { return signedIn() && (request.auth.token.admin == true || request.auth.token.editor == true); }
    function isReviewer() { return signedIn() && (request.auth.token.admin == true || request.auth.token.reviewer == true); }
    function isValidResource() {
      return request.resource.data.keys().hasAll(['title','resourceType','status','updatedAt'])
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 300;
    }

    match /resources/{resourceId} {
      allow read: if resource.data.status == 'published' || isEditor();
      allow create, update: if isEditor() && isValidResource();
      allow delete: if isAdmin();
    }

    match /mediaResources/{resourceId} {
      allow read: if resource.data.status == 'published' || isEditor();
      allow create, update: if isEditor();
      allow delete: if isAdmin();
    }

    match /competencies/{competencyId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /reviews/{reviewId} {
      allow read: if isReviewer();
      allow create, update: if isReviewer();
      allow delete: if isAdmin();
    }

    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow create: if signedIn();
      allow update, delete: if false;
    }

    match /users/{userId} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == userId);
      allow update: if isAdmin() || (signedIn() && request.auth.uid == userId && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName','photoURL','preferences']));
      allow create: if signedIn() && request.auth.uid == userId;
      allow delete: if isAdmin();
    }
  }
}

